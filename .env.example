# Copie para .env e preencha. Nada aqui é segredo, exceto as variáveis da função (não começam com VITE_).

# URL pública do site, sem barra no fim. [DOMÍNIO] ainda não registrado.
VITE_SITE_URL=https://example.com

# Provedor do formulário "Iniciar um projeto": email | formspree | mock
#   email     → função api/briefing.ts envia pelo Resend (com anexos)
#   formspree → direto ao Formspree (anexos só nos planos pagos)
#   mock      → simula (padrão em desenvolvimento quando vazio)
VITE_FORM_PROVIDER=email

# Só para VITE_FORM_PROVIDER=formspree: o código do formulário (formspree.io/f/<código>)
VITE_FORMSPREE_ID=

# Só para VITE_FORM_PROVIDER=email — defina no painel da Vercel, NUNCA no código:
# RESEND_API_KEY=
# BRIEFING_TO=contato@[DOMÍNIO]
# BRIEFING_FROM=Wabori <site@[DOMÍNIO]>
